# =============================================================================
# D3 OMS 自动化套件 —— 环境配置模板
# -----------------------------------------------------------------------------
# 部署时复制本文件为 scripts/config.env 并按需修改：
#     cp deploy/config.env.example scripts/config.env
# 所有脚本会自动 source scripts/config.env（若存在）。
#
# 说明：
#   - 本文件只含占位示例，不含任何真实组织信息；请在 config.env 中填入你自己的值。
#   - 带【密钥】标记的项切勿提交到仓库。
#   - 钉钉侧鉴权不走本文件，由 dws CLI 的登录态（~/.dws）提供，见 README。
# =============================================================================

# ---- D3（点三 OMS）----------------------------------------------------------
export D3_BASE_URL="https://d3.diansan.com"
export D3_TENANT="REPLACE_WITH_YOUR_D3_TENANT"   # 登录租户名
export D3_USERNAME="REPLACE_WITH_YOUR_D3_USERNAME"  # 登录账号/用户名
# 【密钥】D3 登录密码：填写到 scripts/config.env，切勿提交。
# 若浏览器里已保存登录态（ego-browser 配置文件），可留空，脚本会复用登录态。
export D3_PASSWORD=""

# 自动客审「拦截规则」策略编辑页（末尾 id= 改成你自己的策略 ID）
export D3_AUDIT_POLICY_URL="https://d3.diansan.com/omni/setting/policy/new-auto-audit/save/index.html?id=REPLACE_WITH_YOUR_POLICY_ID&action=edit"

# 订单客审页 / 出库计划单页（一般无需改）
export D3_ORDER_CHECK_URL="https://d3.diansan.com/omni/order/order-check/indexFeature/index.html"
export D3_PLAN_URL="https://d3.diansan.com/omni/3rd-warehousing/stock-out-plan/index.html?stockPlanStatus=NOTIFY_SUCCESS"

# ---- 钉钉机器人 / 通知群 -----------------------------------------------------
# 企业内部机器人 robotCode（clientId；其 secret 在 dws 登录态里，不在此配置）
export D3_ROBOT_CODE="REPLACE_WITH_YOUR_ROBOT_CODE"
# 通知群 openConversationId
export D3_NOTIFY_GROUP="REPLACE_WITH_YOUR_GROUP_CONVERSATION_ID"
# 机器人读不到客服组时的兜底 @ 用户（数字 userId）；没有可留空
export D3_DEFAULT_AT_USER=""

# ---- 钉钉多维表：资源定位 ----------------------------------------------------
# 业务 Base
export D3_ATABLE_BASE="REPLACE_WITH_YOUR_BASE_ID"
# 各业务数据表
export D3_TABLE_AUDIT="REPLACE_WITH_TABLE_ID_AUDIT"     # 自动客审拦截表
export D3_TABLE_BUDAN="REPLACE_WITH_TABLE_ID_BUDAN"     # 补单/占单登记表
export D3_TABLE_SHORTAGE="REPLACE_WITH_TABLE_ID_SHORTAGE"  # 缺货跟踪表
export D3_TABLE_STAFF="REPLACE_WITH_TABLE_ID_STAFF"     # 部门-人员对应表（取客服组）

# ---- 业务常量（一般无需改）---------------------------------------------------
export D3_REPLACEMENT_SKU="FF000748"   # 补单换货目标品（运费链接2/棉签）
export D3_SHORTAGE_TAG_ID="613013"     # 缺货标签 ID
export D3_SELLER_MEMO="0000"           # 补单客服备注

# ---- 运行态目录（可选）-------------------------------------------------------
# 监听器 PID / 日志 / 去重状态默认写项目内 .state；如需自定义可改这里。
export D3_RUN_DIR="/tmp"
