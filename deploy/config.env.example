# =============================================================================
# D3 OMS 自动化套件 —— 环境配置模板
# -----------------------------------------------------------------------------
# 部署时复制本文件为 scripts/config.env 并按需修改：
#     cp deploy/config.env.example scripts/config.env
# 所有脚本会自动 source scripts/config.env（若存在）。
#
# 说明：
#   - 下列「资源标识」默认值为本项目原始环境（湖北四通恒远 / 亿民盛世）的值，
#     直接保留即可连同一套钉钉组织与 D3；要迁到别的公司/组织再替换。
#   - 带【密钥】标记的项不会写入仓库，必须在 config.env 里手工填写。
#   - 钉钉侧鉴权不走本文件，由 dws CLI 的登录态（~/.dws）提供，见 README。
# =============================================================================

# ---- D3（点三 OMS）----------------------------------------------------------
export D3_BASE_URL="https://d3.diansan.com"
export D3_TENANT="亿民盛世"            # 登录租户名
export D3_USERNAME="魏鑫仪"            # 登录账号/用户名
# 【密钥】D3 登录密码：请填写到 scripts/config.env，切勿提交。
# 若浏览器里已保存登录态（ego-browser 配置文件），可留空，脚本会复用登录态。
export D3_PASSWORD=""

# 自动客审「拦截规则」策略编辑页（含策略 ID）
export D3_AUDIT_POLICY_URL="https://d3.diansan.com/omni/setting/policy/new-auto-audit/save/index.html?id=678962&action=edit"

# 订单客审页 / 出库计划单页（一般无需改）
export D3_ORDER_CHECK_URL="https://d3.diansan.com/omni/order/order-check/indexFeature/index.html"
export D3_PLAN_URL="https://d3.diansan.com/omni/3rd-warehousing/stock-out-plan/index.html?stockPlanStatus=NOTIFY_SUCCESS"

# ---- 钉钉机器人 / 通知群 -----------------------------------------------------
# MAC糖果机器人 robotCode（机器人 clientId；其 secret 在 dws 登录态里，不在此配置）
export D3_ROBOT_CODE="dingsshadsm8rt5h7ruv"
# 「亿民补单-测试群」openConversationId
export D3_NOTIFY_GROUP="cid5wfiNs3aPtM7DpL050FRUQ=="
# 机器人读不到客服组时的兜底 @ 用户（数字 userId）
export D3_DEFAULT_AT_USER="216162182424059334"

# ---- 钉钉多维表：资源定位 ----------------------------------------------------
# 「发货订单管理系统」Base
export D3_ATABLE_BASE="jb9Y4gmKWrALBykmTe2A2g3l8GXn6lpz"
# 各业务数据表
export D3_TABLE_AUDIT="OQwqwXj"        # 自动客审拦截表
export D3_TABLE_BUDAN="hERWDMS"        # 补单/占单登记表
export D3_TABLE_SHORTAGE="8FWt8wz"     # 缺货跟踪表
export D3_TABLE_STAFF="y89Wute"        # 部门-人员对应表（取客服组）

# ---- 业务常量（一般无需改）---------------------------------------------------
export D3_REPLACEMENT_SKU="FF000748"   # 补单换货目标品（运费链接2/棉签）
export D3_SHORTAGE_TAG_ID="613013"     # 缺货标签 ID
export D3_SELLER_MEMO="0000"           # 补单客服备注

# ---- 运行态目录（可选）-------------------------------------------------------
# 监听器 PID / 日志 / 去重状态默认写 /tmp；如需自定义可改这里。
export D3_RUN_DIR="/tmp"
